{"nodes": [{"id": "docs_app_dashboard", "label": "Skills UI Web Dashboard", "file_type": "document", "source_file": "docs/app.html", "source_location": "html", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-file self-contained web dashboard (v0.5.5) that works both locally from skills-ui serve and remotely on GitHub Pages in hosted mode with zero external runtime assets."}, {"id": "docs_app_content_security_policy", "label": "Content Security Policy (CSP)", "file_type": "rationale", "source_file": "docs/app.html", "source_location": "head meta[http-equiv=Content-Security-Policy]", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Enforces default-src 'none', SHA-256 hashed inline scripts, no-referrer, base-uri 'none', form-action 'none', and restricts network calls to loopback (127.0.0.1 and localhost) so the hosted dashboard cannot exfiltrate data or navigate."}, {"id": "docs_app_catppuccin_theme_system", "label": "Catppuccin Theme & Motion System", "file_type": "rationale", "source_file": "docs/app.html", "source_location": "style [data-theme]", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Catppuccin Mocha and Latte CSS tokens with light-theme accents darkened to pass WCAG AA contrast, aligns all padding/margin/gap values on a 4px Hallmark scale (S-181), and forces animation-iteration-count: 1 when reduced motion is active so infinite loops stop cleanly instead of flickering."}, {"id": "docs_app_js_progressive_gate", "label": "Pre-Paint Script Gate (.js)", "file_type": "rationale", "source_file": "docs/app.html", "source_location": "style .js #settings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Scopes the off-screen hidden state of #settings to the .js class added before first paint (gate 62), keeping drawer content visible in place when scripting is disabled."}, {"id": "docs_app_top_header_bar", "label": "Top Header Bar", "file_type": "concept", "source_file": "docs/app.html", "source_location": "header", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sticky navigation bar housing Installed/Search tabs, Project/Global scope toggle, bulk actions, Hub Health pill, and 32px icon-only inline SVG controls (ICONS, no emoji glyphs per sloplint 30a) that wrap below 720px (S-186)."}, {"id": "docs_app_split_pane_layout", "label": "Resizable Split-Pane Layout", "file_type": "concept", "source_file": "docs/app.html", "source_location": "main #listSplitter", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CSS Grid master-detail layout with an accessible pointer-and-keyboard vertical splitter (#listSplitter) clamping #listPane width between 10% and 50% (default 35%) and persisting via debounced prefs (S-238)."}, {"id": "docs_app_list_pane", "label": "Master List & Search Pane", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#listPane", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unifies Installed skills (#skillList) and Registry Search (#results) in one left pane with shared sort controls, provenance filter (#provRow), agent filter popover (#agentsPop), and a fixed-height permanent .list-head Select-all master checkbox plus inline selection summary (#selSummary) so selection changes never shift layout (S-186, S-187)."}, {"id": "docs_app_detail_pane", "label": "Skill & Search Detail Pane", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#detailPane", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Displays installed skill metadata, conditional Update/Remove actions (S-186), and rendered SKILL.md via showDetail, or registry skill details and sibling source discovery via showSearchDetail, or CLI seed installation via showInstallSeed."}, {"id": "docs_app_settings_drawer", "label": "Settings Drawer", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#settings", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Slide-over modal drawer (#scrim) persisting Theme, Sound effects, Reduce motion, List pane width, and fixed Server port preferences via PUT /api/prefs."}, {"id": "docs_app_connect_dialog", "label": "Hosted Backend Connect Dialog", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#connectDialog", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guides hosted-mode users to pair the GitHub Pages UI with a local skills-ui serve URL and Hosted-UI Bearer token, surfacing targeted diagnostics for allowlist rejections, old binaries, bad tokens, and Safari local-network blocks (S-137)."}, {"id": "docs_app_confirm_dialog", "label": "Remove Confirmation Dialog", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#confirmDialog", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modal confirmation gate for single or batch skill deletion that appends nonLockedWarning when any targeted skill has linked or local provenance."}, {"id": "docs_app_help_dialog", "label": "Keyboard Shortcuts Dialog", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#helpDialog", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_app_toast_notifications", "label": "Toast Notification System", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#toasts", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Polite aria-live status toasts that encode tone via border and indicator dot (>=3:1) while keeping body text on AA-verified --t-text over --t-surfaceAlt, clipping long CLI outputs with clip()."}, {"id": "docs_app_busy_bar", "label": "Busy Status Bar", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#busyBar", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_app_client_state", "label": "Client State Store", "file_type": "code", "source_file": "docs/app.html", "source_location": "script state", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single in-memory state object holding UI selections, preferences, capabilities, install queue, agent/provenance filters, and scope-keyed update caches (UI-07) so project and global rows with identical names remain isolated."}, {"id": "docs_app_hosted_mode_bridge", "label": "Hosted Mode & Loopback API Bridge", "file_type": "concept", "source_file": "docs/app.html", "source_location": "script api probeBackend", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detects non-loopback HOSTED origins, attaches Bearer tokens to loopback backend calls, and stores credentials strictly in sessionStorage (migrating and clearing legacy localStorage) because s-a-c.github.io is a shared origin where sibling pages could otherwise steal tokens (0.5.1 impl B, S-137)."}, {"id": "docs_app_serve_rest_api", "label": "Local skills-ui Serve REST API", "file_type": "concept", "source_file": "docs/app.html", "source_location": "script api", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "HTTP JSON contract exposed by local skills-ui serve (/api/version, /api/prefs, /api/health-check, /api/skills, /api/skill, /api/updates, /api/search, /api/source-skills, /api/install, /api/update, /api/remove), passing exact cached row path on /api/skill for server validation (S-179)."}, {"id": "docs_app_hub_health_popover", "label": "Hub Health Check Popover", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#healthWrap", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capability-gated (capabilities.healthCheck) status pill and detail dialog that refreshes on boot and after every mutation via handlePostMutation, surfacing post-mutation hook failures as error toasts."}, {"id": "docs_app_cli_seed_handoff", "label": "CLI Seed Handoff", "file_type": "concept", "source_file": "docs/app.html", "source_location": "script applySeed showInstallSeed", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Consumes server-injected window.__SEED__ payloads (add, update, remove) at boot, opening source picker for add or intersecting update/remove targets against live installed skills to stay in parity with TUI model.ts pruning (G5, S-187)."}, {"id": "docs_app_dom_reuse_reconciler", "label": "Keyed DOM-Reuse List Reconciler", "file_type": "rationale", "source_file": "docs/app.html", "source_location": "script renderList", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reconciles #skillList rows by scope/name key using rowByKey, content-only rowSignature diffing, 150ms debounced filtering, delegated list listeners, and one-shot .rise-in entrance classes (stripped before moving connected nodes) to avoid rebuilding ~390 DOM rows and ~1.6k listeners per keystroke (S-180, S-186)."}, {"id": "docs_app_perf_timing_instrumentation", "label": "User Timing Filter Render Instrumentation", "file_type": "code", "source_file": "docs/app.html", "source_location": "script scheduleFilterRender", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Emits and clears skills-ui:filter-render User Timing marks/measures around every debounced renderList pass so scripts/perf can measure pure render work excluding debounce and frame pacing without exhausting browser performance entry buffers (S-180)."}, {"id": "docs_app_filter_parity_predicate", "label": "TUI/Web Filter Parity Predicate (skillMatches)", "file_type": "code", "source_file": "docs/app.html", "source_location": "script skillMatches filteredSkills", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Transpiled directly from src/web/page.ts and verified by tests/filter-parity.test.ts so Web UI and TUI share the exact same case-insensitive match set across name, source, agents, and description."}, {"id": "docs_app_markdown_renderer", "label": "Escape-First Safe Markdown Renderer", "file_type": "code", "source_file": "docs/app.html", "source_location": "script renderMarkdown", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-dependency SKILL.md renderer that escapes every text token via esc() before emitting tags, renders links as non-navigating spans to honor default-src 'none' CSP, avoids raw backticks inside template literals, and drops the link regex branch when no '](' is present to prevent O(n^2) backtracking (S-165)."}, {"id": "docs_app_single_disabled_writer", "label": "Single Button Disabled-State Writer (UI-05)", "file_type": "rationale", "source_file": "docs/app.html", "source_location": "script syncButtonDisabled setSemanticDisabled", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Computes button.disabled = state.busy || data-semantic-disabled === 'true' through one writer (syncButtonDisabled/syncButtons) so clearing transient busy state never re-enables semantically disabled buttons and buttons inserted mid-flight inherit busy state (S-206)."}, {"id": "docs_app_async_race_tokens", "label": "Monotonic Generation Tokens for Async Races", "file_type": "rationale", "source_file": "docs/app.html", "source_location": "script skillsLoadSeq detailSeq searchSeq updateCheckSeq", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guards asynchronous list loads (skillsLoadSeq), detail fetches (detailSeq + ownsDetail, S-204), registry searches (searchSeq, S-182), scope-keyed update checks (updateCheckSeq, UI-07), and batch install scope snapshots (installGlobally, S-202) so stale responses never overwrite newer UI state."}, {"id": "docs_app_registry_search_queue", "label": "Registry Search & Batch Install Queue", "file_type": "concept", "source_file": "docs/app.html", "source_location": "script runSearch renderResults installQueue", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Debounced (300ms) registry search with in-place installed/update status indicators (A6), sibling skill discovery via /api/source-skills, and sequential source-grouped batch installation (installQueue)."}, {"id": "docs_app_skills_sh_registry", "label": "skills.sh Skill Registry", "file_type": "concept", "source_file": "docs/app.html", "source_location": "#searchInput", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_app_update_removal_workflow", "label": "Skill Update & Removal Workflow", "file_type": "concept", "source_file": "docs/app.html", "source_location": "script checkForUpdates updateSkills openRemove deleteChecked", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Handles update checks (surfacing failures and per-row error tooltips per G4/ST4), updates, and single/batch removals, treating HTTP 200 with ok:false as explicit CLI failures (G2/ST3) and running post-mutation health checks."}, {"id": "docs_app_webaudio_synth", "label": "WebAudio Synthesized Sound Effects", "file_type": "code", "source_file": "docs/app.html", "source_location": "script play tone", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generates select, confirm, success, and error tones via WebAudio oscillators so the single-file dashboard needs no external audio assets."}, {"id": "docs_app_keyboard_navigation", "label": "Global & Delegated Keyboard Navigation", "file_type": "concept", "source_file": "docs/app.html", "source_location": "script DOMContentLoaded keydown", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Provides global shortcuts (/, f, g/p, a, i, x, ?, Esc preserving filter/search text), accessible splitter arrow/Home/End keys, and delegated list Enter/Space handling that yields to native descendant controls so Space toggles row checkboxes (UI-06, S-207)."}], "edges": [{"source": "docs_app_dashboard", "target": "docs_app_content_security_policy", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/app.html", "source_location": "head", "weight": 1.0}, {"source": "docs_app_dashboard", "target": "docs_app_catppuccin_theme_system", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/app.html", "source_location": "style", "weight": 1.0}, {"source": "docs_app_dashboard", "target": "docs_app_top_header_bar", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/app.html", "source_location": "body header", "weight": 1.0}, {"source": "docs_app_dashboard", "target": "docs_app_split_pane_layout", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/app.html", "source_location": "body main", "weight": 1.0}, {"source": "docs_app_split_pane_layout", "target": "docs_app_list_pane", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/app.html", "source_location": "main", "weight": 1.0}, {"source": "docs_app_split_pane_layout", "target": "docs_app_detail_pane", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/app.html", "source_location": "main", "weight": 1.0}, {"source": "docs_app_split_pane_layout", "target": "docs_app_settings_drawer", "relation": "shares_data_with", 