{
  "name": "skills-ui",
  "version": "0.5.2",
  "description": "TUI/WebUI wrapper for the skills CLI — OpenTUI terminal app + web UI over a local HTTP API, shipped as a self-contained Bun executable.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "selftest": "bun run src/main.ts --selftest",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "export:page": "bun run scripts/export-page.ts",
    "pty-smoke": "uv run --with pyte python scripts/pty-smoke/smoke.py"
  },
  "dependencies": {
    "@opentui/core": "0.7.0",
    "@opentui/keymap": "0.7.0",
    "@opentui/react": "0.7.0",
    "@opentui/three": "0.7.0",
    "react": "19"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "1.4.4"
  }
}
